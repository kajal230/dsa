class Solution {
public:
 
    int minMovesToMakePalindrome(string s) {
        int n=s.size();
        int moves=0;
        int i=0, j=n-1;
        while(i<j){
            if(s[i]==s[j]){
                i++;
                j--;
            }else{
               int k=j;
                while(k>i && s[k]!=s[i]){
                    k--;
                }
                if(k==i){
                    swap(s[i+1],s[i]);
                    moves++;
                }else{
                    while(k<j){
                        swap(s[k],s[k+1]);
                        moves++;
                        k++;
                    }
               i++;
               j--;
                }
            }
        }
        return moves;
    }
};
